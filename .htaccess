RewriteEngine On

# Remove .php extension
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# File/Directory Exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Handle Strays
RewriteRule ^ index.php [QSA,L]

# Custom error pages
ErrorDocument 403 /
ErrorDocument 404 /
ErrorDocument 500 /